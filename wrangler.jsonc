{
  "$schema": "node_modules/wrangler/config-schema.json",
  // O1 resolvido: Daksa (01 §8). Nome técnico do Worker mantido como "site-daksa" — não há
  // motivo para mudar, domínio real é daksa.com.br.
  "name": "site-daksa",
  // Alinhado à versão de workerd resolvida localmente (ver package-lock.json) para garantir
  // paridade entre `astro dev`/`astro build` e o runtime de produção.
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],

  // TODO:O6/O5b — bindings reais (D1 para fallback de lead, Queues para retry de CRM/e-mail,
  // KV para sessão do adapter) entram na Fase 2 (09 §1). Domínio já está resolvido
  // (daksa.com.br); falta o nome do CRM (O6) e o provedor de e-mail transacional (O5b).
  // Sem eles, /api/lead roda em modo stub (ver src/pages/api/lead.ts).
  //
  // "d1_databases": [{ "binding": "LEADS_DB", "database_name": "TODO", "database_id": "TODO" }],
  // "queues": { "producers": [{ "binding": "LEAD_RETRY_QUEUE", "queue": "TODO" }] },

  // NOTA (docs/inputs.md): a doc de referência (02-STACK-INFRA-SEGURANCA.md) descreve o
  // deploy como "Cloudflare Pages" clássico; o adapter atual (@astrojs/cloudflare 14.x) se
  // descreve como adapter para "Cloudflare Workers" (a Cloudflare vem unificando Pages em
  // Workers com Static Assets). Este arquivo cobre dev/build local; o fluxo real de deploy
  // (Pages dashboard vs. `wrangler deploy` com Static Assets) precisa ser confirmado contra
  // o produto Cloudflare atual na Fase 5, quando O5 for resolvido.
}
