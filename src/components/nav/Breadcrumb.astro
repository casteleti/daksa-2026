---
/**
 * Breadcrumb — fonte: 05 §3. Presente em todas as páginas exceto home e /diagnostico (03 §5).
 * Mobile: trunca no meio, mantém primeiro e último (05 §3) — feito via CSS (overflow com fade).
 */
export interface Crumb {
  name: string;
  href: string;
}

export interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol role="list" class="breadcrumb__list">
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="breadcrumb__item">
            {isLast ? (
              <span aria-current="page">{item.name}</span>
            ) : (
              <a href={item.href}>{item.name}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .breadcrumb__list {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    white-space: nowrap;
    font-size: var(--fs-100);
    color: var(--fg-muted);
  }
  .breadcrumb__item:not(:last-child)::after {
    content: '/';
    margin-inline-start: var(--sp-2);
    color: var(--fg-muted);
  }
  .breadcrumb__item a {
    color: inherit;
    text-decoration: none;
  }
  .breadcrumb__item a:hover {
    text-decoration: underline;
  }
  .breadcrumb__item [aria-current='page'] {
    color: var(--fg);
  }

  /* Mobile: só primeiro e último item visíveis, meio colapsado (05 §3) */
  @media (max-width: 30rem) {
    .breadcrumb__item:not(:first-child):not(:last-child):not(:nth-last-child(2)) {
      display: none;
    }
    .breadcrumb__item:first-child::after {
      content: '/ … /';
    }
  }
</style>
