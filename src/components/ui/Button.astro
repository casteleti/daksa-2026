---
/**
 * Button — fonte: 05-DESIGN-SYSTEM.md §3.
 * Variantes: primary (âmbar sólido) · secondary (borda 1,5px) · ghost (texto sublinhado).
 * Sem seta decorativa (01 §4, 05 §1.3). <a> quando `href`, <button> caso contrário.
 */
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  loading?: boolean;
  disabled?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  loading = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
---

<Tag
  href={href}
  type={href ? undefined : type}
  class={classes}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  aria-busy={loading ? 'true' : undefined}
  {...rest}
>
  {loading && <span class="btn__spinner" aria-hidden="true" />}
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    font-family: var(--font-text);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--r-1);
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn--md {
    block-size: 48px;
    padding-inline: var(--sp-6);
    font-size: var(--fs-200);
  }
  .btn--lg {
    block-size: 52px;
    padding-inline: var(--sp-8);
    font-size: var(--fs-300);
  }

  .btn--primary {
    background: var(--accent);
    color: var(--accent-fg);
    border: var(--bw-2) solid var(--accent);
  }
  .btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .btn--secondary {
    background: transparent;
    color: var(--fg);
    border: var(--bw-2) solid var(--fg);
  }
  .btn--secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn--ghost {
    background: transparent;
    border: none;
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    padding-inline: 0;
    block-size: auto;
  }
  .btn--ghost:hover {
    color: var(--accent);
  }

  .btn[disabled],
  .btn[aria-disabled='true'] {
    opacity: var(--op-disabled);
    pointer-events: none;
  }

  .btn__spinner {
    inline-size: 16px;
    block-size: 16px;
    border-radius: 50%;
    border: 2px solid currentColor;
    border-inline-end-color: transparent;
    animation: btn-spin var(--dur-4) linear infinite;
  }
  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn__spinner {
      animation-duration: 1.2s;
    }
  }

  /* 100% largura em formulários e CTA final, < 32rem — aplicado pelo contexto via classe utilitária */
  @media (max-width: 31.9375rem) {
    .btn--full-mobile {
      inline-size: 100%;
    }
  }
</style>
