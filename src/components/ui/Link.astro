---
/**
 * Link — fonte: 05-DESIGN-SYSTEM.md §3. Variantes: inline, nav, footer, external.
 * Sem seta decorativa (01 §4). Texto do slot deve ser descritivo — nunca "clique aqui".
 */
export interface Props {
  href: string;
  variant?: 'inline' | 'nav' | 'footer' | 'external';
  class?: string;
}
const { href, variant = 'inline', class: className } = Astro.props;

const isExternal = variant === 'external' || /^https?:\/\//.test(href);
const classes = ['link', `link--${variant}`, className].filter(Boolean).join(' ');
---

<a
  href={href}
  class={classes}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <slot />
  {
    isExternal && (
      <svg
        aria-hidden="true"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        class="link__external-icon"
      >
        <path
          d="M7 17L17 7M17 7H9M17 7v8"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  {isExternal && <span class="visually-hidden">(abre em nova aba)</span>}
</a>

<style>
  .link {
    color: inherit;
  }
  .link--inline {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .link--inline:hover {
    text-decoration-color: var(--accent);
  }
  .link--nav,
  .link--footer {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }
  .link--nav:hover,
  .link--footer:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .link--external {
    text-decoration: underline;
    text-underline-offset: 3px;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }
  .link__external-icon {
    flex-shrink: 0;
  }
</style>
